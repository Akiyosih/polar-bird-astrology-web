---
import { localizedPath, type Lang } from "../lib/i18n";
import { corePayUrl, repoUrl, uiCopy } from "../data/site";

type Props = {
  lang: Lang;
};

const { lang } = Astro.props;
const copy = uiCopy[lang];
---

<footer class="site-footer">
  <p>{copy.footerNotice}</p>
  <div class="footer-links">
    <a href={localizedPath(lang, "reading-policy")}>{copy.footerLinks.readingPolicy}</a>
    <a href={localizedPath(lang, "purchase")}>{copy.footerLinks.purchase}</a>
    <a href={repoUrl}>{copy.footerLinks.github}</a>
    <a href={corePayUrl}>{copy.footerLinks.corepay}</a>
  </div>
</footer>
