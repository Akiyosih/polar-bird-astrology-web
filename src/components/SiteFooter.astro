---
import { localizedPath, type Lang } from "../lib/i18n";
import { uiCopy } from "../data/site";

type Props = {
  lang: Lang;
};

const { lang } = Astro.props;
const copy = uiCopy[lang];
---

<footer class="site-footer">
  <p>{copy.footerNotice}</p>
  <div class="footer-links">
    <a href={localizedPath(lang, "sample-reports")}>{copy.footerLinks.sampleReports}</a>
    <a href={localizedPath(lang, "purchase")}>{copy.footerLinks.purchase}</a>
    <a href={localizedPath(lang, "reading-policy")}>{copy.footerLinks.readingPolicy}</a>
    <a href={localizedPath(lang, "about")}>{copy.footerLinks.about}</a>
  </div>
</footer>
