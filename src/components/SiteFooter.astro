---
import { localizedPath, type Lang } from "../lib/i18n";
import { uiCopy } from "../data/site";

type Props = {
  lang: Lang;
};

const { lang } = Astro.props;
const copy = uiCopy[lang];
---

<footer class="site-footer">
  <p>{copy.footerNotice}</p>
  <div class="footer-links">
    <a href={localizedPath(lang, "sample-reports")}>{copy.footerLinks.sampleReports}</a>
    <a href={localizedPath(lang, "order")}>{copy.footerLinks.order}</a>
    <a href={localizedPath(lang, "approach")}>{copy.footerLinks.approach}</a>
    <a href={localizedPath(lang, "writer")}>{copy.footerLinks.writer}</a>
  </div>
</footer>
