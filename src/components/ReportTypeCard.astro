---
import type { ReportTypeKey } from "../data/site";
import type { FieldNote } from "../lib/fieldNotes";
import type { Lang } from "../lib/i18n";
import { localizedPath } from "../lib/i18n";

type ReportTypeCardCopy = {
  key: ReportTypeKey;
  label: string;
  title: string;
  summary: string;
  focus: string;
  emptyLabel: string;
};

type Props = {
  lang: Lang;
  report: ReportTypeCardCopy;
  note?: FieldNote;
  readLabel: string;
  focusLabel: string;
  periodLabel: string;
};

const { lang, report, note, readLabel, focusLabel, periodLabel } = Astro.props;
const noteHref = note ? localizedPath(lang, `core-field-notes/${note.slug}`) : undefined;
const titleLines = report.title.split("\n");
const accessibleTitle = report.title.replace(/\s+/g, " ");
---

<article class:list={["report-type-card", note ? "is-available" : "is-empty"]} data-report={report.key}>
  {noteHref && <a class="card-hit-link" href={noteHref} aria-label={`${accessibleTitle} ${readLabel}`}></a>}
  <p class="eyebrow">{report.label}</p>
  <h2>
    {titleLines.map((line) => <span class="report-title-line">{line}</span>)}
  </h2>
  <p>{report.summary}</p>
  <dl class="report-meta">
    <div>
      <dt>{focusLabel}</dt>
      <dd>{report.focus}</dd>
    </div>
    {note?.period && (
      <div>
        <dt>{periodLabel}</dt>
        <dd>{note.period}</dd>
      </div>
    )}
  </dl>
  <div class="card-actions">
    {
      note ? (
        <span class="button secondary" aria-hidden="true">
          {readLabel}
        </span>
      ) : (
        <span class="status-pill">{report.emptyLabel}</span>
      )
    }
  </div>
</article>
