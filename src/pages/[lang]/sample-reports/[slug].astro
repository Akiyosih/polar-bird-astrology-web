---
import BoundaryBox from "../../../components/BoundaryBox.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { chartLegendGroups, sampleSubjects, uiCopy } from "../../../data/site";
import {
  getLatestSampleReportBySubjectAndReportType,
  getSampleReport,
  getSampleReportStaticPaths
} from "../../../lib/sampleReports";
import type { SampleReport } from "../../../lib/sampleReports";
import { isLang, languages, localizedPath } from "../../../lib/i18n";

export function getStaticPaths() {
  return getSampleReportStaticPaths();
}

const lang = Astro.params.lang;
const slug = Astro.params.slug;

if (!isLang(lang)) {
  throw new Error(`Unsupported language: ${lang}`);
}

const sampleReport = getSampleReport(lang, slug);
if (!sampleReport) {
  throw new Error(`Unknown sample report: ${slug}`);
}
const ui = uiCopy[lang];
const publicationBoundaryParagraphs = ui.publicationBoundaryParagraphs ?? [ui.publicationBoundaryText];
const downloadLabel = lang === "ja" ? "PDFをダウンロード" : lang === "de" ? "PDF herunterladen" : "Download PDF";
const chartHeading = lang === "ja" ? "ホロスコープ" : lang === "de" ? "Horoskop" : "Chart";
const isSampleReport = (item: SampleReport | undefined): item is SampleReport => Boolean(item);
const activeSubject = sampleSubjects[lang].find((subject) => subject.key === sampleReport.subject) ?? sampleSubjects[lang][0];
const otherReports = activeSubject.reports
  .map((report) => getLatestSampleReportBySubjectAndReportType(lang, activeSubject.key, report.key))
  .filter(isSampleReport)
  .filter((item) => item.slug !== sampleReport.slug);
const sampleReportsBackHref = `${localizedPath(lang, "sample-reports")}#sample-subject-${activeSubject.key}`;
const languagePaths = Object.fromEntries(
  languages.map((code) => [
    code,
    getSampleReport(code, slug)
      ? localizedPath(code, `sample-reports/${slug}`)
      : localizedPath(code, "sample-reports")
  ])
) as Partial<Record<typeof lang, string>>;

function escapeHtml(value: string) {
  return value
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

const titleHtml = escapeHtml(sampleReport.title).replace(/([^\s])レポート/g, "$1<wbr />レポート");
---

<BaseLayout lang={lang} title={sampleReport.title} description={sampleReport.summary} languagePaths={languagePaths}>
  <article class="sample-report report-page">
    <header class="report-cover" style={sampleReport.coverImage ? `--report-cover-image: url(${sampleReport.coverImage})` : undefined}>
      <div class="report-cover-panel">
        <span class="cover-mark" aria-hidden="true">
          <img src="/images/brand/polar-bird-symbol-dark.webp" width="768" height="768" alt="" />
        </span>
        <p class="eyebrow">Polar Bird Astrology</p>
        <p class="report-kind">{sampleReport.eyebrow}</p>
        <h1 set:html={titleHtml} />
        <p>{sampleReport.summary}</p>
        <div class="report-actions">
          {sampleReport.period && (
            <div class="report-period-row">
              <span class="status-pill muted">{sampleReport.period}</span>
            </div>
          )}
          <div class="report-action-row">
            {sampleReport.pdfUrl && <a class="button primary" href={sampleReport.pdfUrl} download>{downloadLabel}</a>}
            {otherReports.length > 0 && (
              <nav class="report-inline-links" aria-label={ui.otherSamplesShortLabel}>
                <span>{ui.otherSamplesShortLabel}</span>
                {otherReports.map((item) => (
                  <a href={localizedPath(lang, `sample-reports/${item.slug}`)}>{item.eyebrow}</a>
                ))}
              </nav>
            )}
          </div>
        </div>
      </div>
    </header>

    {sampleReport.chartImage && (
      <figure class="chart-panel">
        <figcaption class="sr-only">{chartHeading}</figcaption>
        <div class="chart-image-frame">
          <img
            src={sampleReport.chartImage}
            data-theme-image
            data-light-src={sampleReport.chartImage}
            data-dark-src={sampleReport.chartImageDark}
            alt={sampleReport.chartAlt || ""}
            loading="lazy"
          />
        </div>
        <div class="chart-legend" aria-label={ui.chartLegendTitle}>
          <p class="chart-legend-title">{ui.chartLegendTitle}</p>
          <div class="chart-legend-groups">
            {chartLegendGroups[lang].map((group) => (
              <ul data-group={group.key}>
                {group.items.map((item) => (
                  <li data-point={item.key}>
                    <span class="legend-glyph" aria-hidden="true">{item.glyph}</span>
                    <span>{item.label}</span>
                  </li>
                ))}
              </ul>
            ))}
          </div>
        </div>
      </figure>
    )}

    {sampleReport.tableOfContents.length > 0 && (
      <nav id="report-toc" class="report-toc" aria-labelledby="report-toc-title">
        <h2 id="report-toc-title">{ui.tableOfContentsTitle}</h2>
        <ol>
          {sampleReport.tableOfContents.map((item) => (
            <li data-level={item.level}>
              <a href={`#${item.id}`}>{item.title}</a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <BoundaryBox title={ui.publicationBoundaryTitle}>
      {publicationBoundaryParagraphs.map((paragraph) => <p>{paragraph}</p>)}
    </BoundaryBox>

    <section class="report-body" set:html={sampleReport.bodyHtml} />

    <nav class="report-end-nav" aria-label={ui.otherSamplesLabel}>
      <div class="report-end-actions">
        <a class="button primary" href={localizedPath(lang, "purchase")}>{ui.purchaseStatusLabel}</a>
        <a class="button secondary" href={sampleReportsBackHref}>{ui.sampleReportsBackLabel}</a>
      </div>
      {otherReports.length > 0 && (
        <div class="report-end-samples">
          <h2>{ui.otherSamplesLabel}</h2>
          <div>
            {otherReports.map((item) => (
              <a href={localizedPath(lang, `sample-reports/${item.slug}`)}>{item.eyebrow}</a>
            ))}
          </div>
        </div>
      )}
    </nav>
  </article>
</BaseLayout>
