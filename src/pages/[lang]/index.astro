---
import ReportTypeCard from "../../components/ReportTypeCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { homeCopy, reportTypes, uiCopy } from "../../data/site";
import { getLatestFieldNoteByReportType } from "../../lib/fieldNotes";
import { isLang, languages, localizedPath } from "../../lib/i18n";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang;
if (!isLang(lang)) {
  throw new Error(`Unsupported language: ${lang}`);
}

const copy = homeCopy[lang];
const ui = uiCopy[lang];
const descriptionParagraphs = copy.descriptionParagraphs ?? [copy.description];
const reportHubDescriptionParagraphs = ui.reportHubDescriptionParagraphs ?? [ui.reportHubDescription];
const resolveLink = (href: string) => (/^https?:\/\//.test(href) ? href : localizedPath(lang, href));
---

<BaseLayout lang={lang} title={copy.title} description={copy.description}>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.title}</h1>
      {descriptionParagraphs.map((paragraph) => <p>{paragraph}</p>)}
      <div class="hero-actions">
        <a class="button primary" href={localizedPath(lang, "core-field-notes")}>{ui.heroPrimary}</a>
        <a class="button secondary" href={localizedPath(lang, "purchase")}>{ui.heroSecondary}</a>
      </div>
    </div>
    <div class="hero-visual" aria-hidden="true">
      <span class="brand-seal">
        <img src="/images/brand/polar-bird-seal-dark.webp" width="1024" height="1024" alt="" />
      </span>
    </div>
  </section>

  <section class="report-hub" aria-labelledby="report-hub-title">
    <div class="section-heading">
      <p class="eyebrow">{ui.reportHubEyebrow}</p>
      <h2 id="report-hub-title">{ui.reportHubTitle}</h2>
      {reportHubDescriptionParagraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <div class="report-grid">
      {reportTypes[lang].map((report) => (
        <ReportTypeCard
          lang={lang}
          report={report}
          note={getLatestFieldNoteByReportType(lang, report.key)}
          readLabel={ui.readNoteLabel}
          focusLabel={ui.focusLabel}
          periodLabel={ui.periodLabel}
        />
      ))}
    </div>
  </section>

  {copy.blocks.length > 0 && (
    <section class="content-grid">
      {copy.blocks.map((block) => (
        <article>
          <h2>{block.heading}</h2>
          {block.body.map((paragraph) => <p>{paragraph}</p>)}
          {block.link && <a class="text-link" href={resolveLink(block.link.href)}>{block.link.label}</a>}
        </article>
      ))}
    </section>
  )}
</BaseLayout>
