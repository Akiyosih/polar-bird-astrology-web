---
import BoundaryBox from "../../components/BoundaryBox.astro";
import ReportTypeCard from "../../components/ReportTypeCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { homeCopy, reportTypes, uiCopy } from "../../data/site";
import { getLatestFieldNoteByReportType } from "../../lib/fieldNotes";
import { isLang, languages, localizedPath } from "../../lib/i18n";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang;
if (!isLang(lang)) {
  throw new Error(`Unsupported language: ${lang}`);
}

const copy = homeCopy[lang];
const ui = uiCopy[lang];
---

<BaseLayout lang={lang} title={copy.title} description={copy.description}>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.title}</h1>
      <p>{copy.description}</p>
      <div class="hero-actions">
        <a class="button primary" href={localizedPath(lang, "core-field-notes")}>{ui.heroPrimary}</a>
        <a class="button secondary" href={localizedPath(lang, "status")}>{ui.heroSecondary}</a>
      </div>
    </div>
    <img src="/images/watercolor/polar-field-wash.png" width="960" height="540" alt="" />
  </section>

  <BoundaryBox title={ui.boundaryTitle}>
    <p>{ui.boundaryText}</p>
  </BoundaryBox>

  <section class="report-hub" aria-labelledby="report-hub-title">
    <div class="section-heading">
      <p class="eyebrow">{ui.reportHubEyebrow}</p>
      <h2 id="report-hub-title">{ui.reportHubTitle}</h2>
      <p>{ui.reportHubDescription}</p>
    </div>
    <div class="report-grid">
      {reportTypes[lang].map((report) => (
        <ReportTypeCard
          lang={lang}
          report={report}
          note={getLatestFieldNoteByReportType(lang, report.key)}
          readLabel={ui.readNoteLabel}
          focusLabel={ui.focusLabel}
        />
      ))}
    </div>
  </section>

  <section class="content-grid">
    {copy.blocks.map((block) => (
      <article>
        <h2>{block.heading}</h2>
        {block.body.map((paragraph) => <p>{paragraph}</p>)}
      </article>
    ))}
  </section>
</BaseLayout>
