---
import ReportTypeCard from "../../../components/ReportTypeCard.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { homeCopy, reportTypes, uiCopy } from "../../../data/site";
import { getLatestFieldNoteByReportType } from "../../../lib/fieldNotes";
import { isLang, languages, localizedPath } from "../../../lib/i18n";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang;
if (!isLang(lang)) {
  throw new Error(`Unsupported language: ${lang}`);
}

const ui = uiCopy[lang];
const reportTypeGuide = homeCopy[lang].blocks[0];
const reportHubDescriptionParagraphs = ui.reportHubDescriptionParagraphs ?? [ui.reportHubDescription];
const resolveLink = (href: string) => (/^https?:\/\//.test(href) ? href : localizedPath(lang, href));
---

<BaseLayout lang={lang} title={ui.fieldNotesTitle} description={ui.fieldNotesDescription}>
  <section class="page-heading">
    <p class="eyebrow">{ui.fieldNotesEyebrow}</p>
    <h1>{ui.fieldNotesTitle}</h1>
    <p>{ui.fieldNotesDescription}</p>
  </section>

  <section class="report-hub" aria-labelledby="report-hub-title">
    <div class="section-heading">
      <p class="eyebrow">{ui.reportHubEyebrow}</p>
      <h2 id="report-hub-title">{ui.reportHubTitle}</h2>
      {reportHubDescriptionParagraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <div class="report-grid">
      {reportTypes[lang].map((report) => (
        <ReportTypeCard
          lang={lang}
          report={report}
          note={getLatestFieldNoteByReportType(lang, report.key)}
          readLabel={ui.readNoteLabel}
          focusLabel={ui.focusLabel}
          periodLabel={ui.periodLabel}
        />
      ))}
    </div>
  </section>

  <section class="article-flow sample-guide" aria-labelledby="report-type-guide-title">
    <article>
      <h2 id="report-type-guide-title">{reportTypeGuide.heading}</h2>
      {reportTypeGuide.body.map((paragraph) => <p>{paragraph}</p>)}
      {reportTypeGuide.link && (
        <a class="text-link" href={resolveLink(reportTypeGuide.link.href)}>{reportTypeGuide.link.label}</a>
      )}
    </article>
  </section>
</BaseLayout>
