---
import BoundaryBox from "../../../components/BoundaryBox.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { chartLegendItems, uiCopy } from "../../../data/site";
import { getFieldNote, getFieldNoteStaticPaths } from "../../../lib/fieldNotes";
import { isLang, languages, localizedPath } from "../../../lib/i18n";

export function getStaticPaths() {
  return getFieldNoteStaticPaths();
}

const lang = Astro.params.lang;
const slug = Astro.params.slug;

if (!isLang(lang)) {
  throw new Error(`Unsupported language: ${lang}`);
}

const note = getFieldNote(lang, slug);
if (!note) {
  throw new Error(`Unknown field note: ${slug}`);
}
const ui = uiCopy[lang];
const publicationBoundaryParagraphs = ui.publicationBoundaryParagraphs ?? [ui.publicationBoundaryText];
const downloadLabel = lang === "ja" ? "PDFをダウンロード" : lang === "de" ? "PDF herunterladen" : "Download PDF";
const chartHeading = lang === "ja" ? "ホロスコープ" : lang === "de" ? "Horoskop" : "Horoscope";
const languagePaths = Object.fromEntries(
  languages.map((code) => [
    code,
    getFieldNote(code, slug)
      ? localizedPath(code, `core-field-notes/${slug}`)
      : localizedPath(code, "core-field-notes")
  ])
) as Partial<Record<typeof lang, string>>;

function escapeHtml(value: string) {
  return value
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

const titleHtml = escapeHtml(note.title).replace(/([^\s])フィールドノート/g, "$1<wbr />フィールドノート");
---

<BaseLayout lang={lang} title={note.title} description={note.summary} languagePaths={languagePaths}>
  <article class="field-note report-page">
    <header class="report-cover" style={note.coverImage ? `--report-cover-image: url(${note.coverImage})` : undefined}>
      <div class="report-cover-panel">
        <span class="cover-mark" aria-hidden="true">
          <img src="/images/brand/polar-bird-symbol-dark.webp" width="768" height="768" alt="" />
        </span>
        <p class="eyebrow">Polar Bird Astrology</p>
        <p class="report-kind">{note.eyebrow}</p>
        <h1 set:html={titleHtml} />
        <p>{note.summary}</p>
        <div class="report-actions">
          <span class="status-pill">{note.status}</span>
          {note.period && <span class="status-pill muted">{note.period}</span>}
          {note.pdfUrl && <a class="button primary" href={note.pdfUrl} download>{downloadLabel}</a>}
        </div>
      </div>
    </header>

    {note.chartImage && (
      <figure class="chart-panel">
        <figcaption class="sr-only">{chartHeading}</figcaption>
        <div class="chart-image-frame">
          <img src={note.chartImage} alt={note.chartAlt || ""} loading="lazy" />
        </div>
        <div class="chart-legend" aria-label={ui.chartLegendTitle}>
          <p class="chart-legend-title">{ui.chartLegendTitle}</p>
          <ul>
            {chartLegendItems[lang].map((item) => (
              <li data-point={item.key}>
                <span class="legend-glyph" aria-hidden="true">{item.glyph}</span>
                <span>{item.label}</span>
              </li>
            ))}
          </ul>
        </div>
      </figure>
    )}

    <BoundaryBox title={ui.publicationBoundaryTitle}>
      {publicationBoundaryParagraphs.map((paragraph) => <p>{paragraph}</p>)}
    </BoundaryBox>

    <section class="report-body" set:html={note.bodyHtml} />
  </article>
</BaseLayout>
