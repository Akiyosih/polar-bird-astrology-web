---
import BoundaryBox from "../../../components/BoundaryBox.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { chartLegendGroups, reportTypes, uiCopy } from "../../../data/site";
import { getFieldNote, getFieldNoteStaticPaths, getLatestFieldNoteByReportType } from "../../../lib/fieldNotes";
import type { FieldNote } from "../../../lib/fieldNotes";
import { isLang, languages, localizedPath } from "../../../lib/i18n";

export function getStaticPaths() {
  return getFieldNoteStaticPaths();
}

const lang = Astro.params.lang;
const slug = Astro.params.slug;

if (!isLang(lang)) {
  throw new Error(`Unsupported language: ${lang}`);
}

const note = getFieldNote(lang, slug);
if (!note) {
  throw new Error(`Unknown field note: ${slug}`);
}
const ui = uiCopy[lang];
const publicationBoundaryParagraphs = ui.publicationBoundaryParagraphs ?? [ui.publicationBoundaryText];
const downloadLabel = lang === "ja" ? "PDFをダウンロード" : lang === "de" ? "PDF herunterladen" : "Download PDF";
const chartHeading = lang === "ja" ? "ホロスコープ" : lang === "de" ? "Horoskop" : "Chart";
const isFieldNote = (item: FieldNote | undefined): item is FieldNote => Boolean(item);
const otherNotes = reportTypes[lang]
  .map((report) => getLatestFieldNoteByReportType(lang, report.key))
  .filter(isFieldNote)
  .filter((item) => item.slug !== note.slug);
const languagePaths = Object.fromEntries(
  languages.map((code) => [
    code,
    getFieldNote(code, slug)
      ? localizedPath(code, `core-field-notes/${slug}`)
      : localizedPath(code, "core-field-notes")
  ])
) as Partial<Record<typeof lang, string>>;

function escapeHtml(value: string) {
  return value
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

const titleHtml = escapeHtml(note.title).replace(/([^\s])フィールドノート/g, "$1<wbr />フィールドノート");
---

<BaseLayout lang={lang} title={note.title} description={note.summary} languagePaths={languagePaths}>
  <article class="field-note report-page">
    <header class="report-cover" style={note.coverImage ? `--report-cover-image: url(${note.coverImage})` : undefined}>
      <div class="report-cover-panel">
        <span class="cover-mark" aria-hidden="true">
          <img src="/images/brand/polar-bird-symbol-dark.webp" width="768" height="768" alt="" />
        </span>
        <p class="eyebrow">Polar Bird Astrology</p>
        <p class="report-kind">{note.eyebrow}</p>
        <h1 set:html={titleHtml} />
        <p>{note.summary}</p>
        <div class="report-actions">
          {note.period && <span class="status-pill muted">{note.period}</span>}
          {note.pdfUrl && <a class="button primary" href={note.pdfUrl} download>{downloadLabel}</a>}
          {otherNotes.length > 0 && (
            <nav class="report-inline-links" aria-label={ui.otherSamplesShortLabel}>
              <span>{ui.otherSamplesShortLabel}</span>
              {otherNotes.map((item) => (
                <a href={localizedPath(lang, `core-field-notes/${item.slug}`)}>{item.eyebrow}</a>
              ))}
            </nav>
          )}
        </div>
      </div>
    </header>

    {note.chartImage && (
      <figure class="chart-panel">
        <figcaption class="sr-only">{chartHeading}</figcaption>
        <div class="chart-image-frame">
          <img
            src={note.chartImage}
            data-theme-image
            data-light-src={note.chartImage}
            data-dark-src={note.chartImageDark}
            alt={note.chartAlt || ""}
            loading="lazy"
          />
        </div>
        <div class="chart-legend" aria-label={ui.chartLegendTitle}>
          <p class="chart-legend-title">{ui.chartLegendTitle}</p>
          <div class="chart-legend-groups">
            {chartLegendGroups[lang].map((group) => (
              <ul data-group={group.key}>
                {group.items.map((item) => (
                  <li data-point={item.key}>
                    <span class="legend-glyph" aria-hidden="true">{item.glyph}</span>
                    <span>{item.label}</span>
                  </li>
                ))}
              </ul>
            ))}
          </div>
        </div>
      </figure>
    )}

    {note.tableOfContents.length > 0 && (
      <nav id="report-toc" class="report-toc" aria-labelledby="report-toc-title">
        <h2 id="report-toc-title">{ui.tableOfContentsTitle}</h2>
        <ol>
          {note.tableOfContents.map((item) => (
            <li data-level={item.level}>
              <a href={`#${item.id}`}>{item.title}</a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <BoundaryBox title={ui.publicationBoundaryTitle}>
      {publicationBoundaryParagraphs.map((paragraph) => <p>{paragraph}</p>)}
    </BoundaryBox>

    <section class="report-body" set:html={note.bodyHtml} />

    <nav class="report-end-nav" aria-label={ui.otherSamplesLabel}>
      <div class="report-end-actions">
        <a class="button primary" href={localizedPath(lang, "purchase")}>{ui.purchaseStatusLabel}</a>
        <a class="button secondary" href={localizedPath(lang, "core-field-notes")}>{ui.sampleReportsBackLabel}</a>
      </div>
      {otherNotes.length > 0 && (
        <div class="report-end-samples">
          <h2>{ui.otherSamplesLabel}</h2>
          <div>
            {otherNotes.map((item) => (
              <a href={localizedPath(lang, `core-field-notes/${item.slug}`)}>{item.eyebrow}</a>
            ))}
          </div>
        </div>
      )}
    </nav>
  </article>
</BaseLayout>
