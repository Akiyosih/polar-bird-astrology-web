---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { pages, type PageKey } from "../../data/site";
import { isLang, languages, localizedPath } from "../../lib/i18n";

const pageKeys = ["purchase", "reading-policy", "about"] satisfies PageKey[];

export function getStaticPaths() {
  const staticPageKeys = ["purchase", "reading-policy", "about"] satisfies PageKey[];
  return languages.flatMap((lang) => staticPageKeys.map((page) => ({ params: { lang, page } })));
}

const lang = Astro.params.lang;
const page = Astro.params.page as PageKey;

if (!isLang(lang) || !pageKeys.includes(page)) {
  throw new Error(`Unsupported route: ${lang}/${page}`);
}

const copy = pages[lang][page];
const descriptionParagraphs = copy.descriptionParagraphs ?? [copy.description];
const resolveLink = (href: string) => (/^https?:\/\//.test(href) ? href : localizedPath(lang, href));
---

<BaseLayout lang={lang} title={copy.title} description={copy.description}>
  <section class="page-heading">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1>{copy.title}</h1>
    {descriptionParagraphs.map((paragraph) => <p>{paragraph}</p>)}
  </section>
  <section class="article-flow">
    {copy.blocks.map((block) => (
      <article>
        <h2>{block.heading}</h2>
        {block.body.map((paragraph) => <p>{paragraph}</p>)}
        {block.link && <a class="text-link" href={resolveLink(block.link.href)}>{block.link.label}</a>}
      </article>
    ))}
    {copy.links && copy.links.length > 0 && (
      <nav class="page-links" aria-label="Related links">
        {copy.links.map((link) => (
          <a class="button secondary" href={resolveLink(link.href)}>{link.label}</a>
        ))}
      </nav>
    )}
  </section>
</BaseLayout>
