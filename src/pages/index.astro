---
import { languageLabels, languages, localizedPath } from "../lib/i18n";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Choose a language for Polar Bird Astrology reports." />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/images/brand/polar-bird-icon-180.png" />
    <title>Polar Bird Astrology</title>
  </head>
  <body class="root-choice">
    <main class="language-choice" aria-labelledby="language-title">
      <img src="/images/brand/polar-bird-seal-dark.webp" width="1024" height="1024" alt="" />
      <div>
        <p class="eyebrow">Astrology reports that read charts for timing and choice</p>
        <h1 id="language-title">Polar Bird Astrology</h1>
        <p>Choose a language. The current samples read Core Blockchain. Polar Bird Astrology reads natal charts, solar returns, and new moon cycles for self-understanding, daily choices, and action planning.</p>
        <nav aria-label="Language">
          {languages.map((lang) => <a href={localizedPath(lang)}>{languageLabels[lang]}</a>)}
        </nav>
      </div>
    </main>
  </body>
</html>
