---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import ThemeInit from "../components/ThemeInit.astro";
import "../styles/global.css";
import type { Lang } from "../lib/i18n";

type Props = {
  lang: Lang;
  title?: string;
  description?: string;
  robots?: string;
  languagePaths?: Partial<Record<Lang, string>>;
};

const { lang, title, description, robots, languagePaths } = Astro.props;
const pageTitle = title ? `${title} | Polar Bird Astrology` : "Polar Bird Astrology";
const pageDescription =
  description ||
  "Polar Bird Astrology publishes reports that read natal charts, solar returns, and new moon cycles for self-understanding, daily choices, and action planning.";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="color-scheme" content="light dark" />
    {robots && <meta name="robots" content={robots} />}
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/images/brand/polar-bird-icon-180.png" />
    <ThemeInit />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <SiteHeader lang={lang} languagePaths={languagePaths} />
      <main id="main">
        <slot />
      </main>
      <script is:inline>
        (() => {
          const root = document.documentElement;
          const images = document.querySelectorAll("[data-theme-image][data-dark-src]");
          if (!images.length) {
            return;
          }

          const syncImages = () => {
            const useDark = root.dataset.theme === "dark";
            images.forEach((image) => {
              const lightSrc = image.getAttribute("data-light-src");
              const darkSrc = image.getAttribute("data-dark-src");
              const nextSrc = useDark && darkSrc ? darkSrc : lightSrc;
              if (nextSrc && image.getAttribute("src") !== nextSrc) {
                image.setAttribute("src", nextSrc);
              }
            });
          };

          syncImages();
          new MutationObserver(syncImages).observe(root, {
            attributes: true,
            attributeFilter: ["data-theme"]
          });
        })();
      </script>
      <SiteFooter lang={lang} />
    </div>
  </body>
</html>
